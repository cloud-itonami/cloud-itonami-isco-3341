;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": an office-coordination robot performs
;; task-record filing, shift-board updates and supply-closet restocking (ISCO
;; 3341 office supervisors). Its physical work: lifting copy-paper cases onto
;; the supply-closet shelf, and bringing the restock cart from the loading
;; area to the closet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3341"
 :cases
 [{:id :paper-case-to-closet-shelf
   :kind :manipulator
   :procedure "arm lifts copy paper (single reams up to a full 5-ream case) from the cart onto the supply-closet shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 6.0 :m2-kg 4.0
            :from [0.60 0.15] :to [0.35 0.75] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.5 5.0 7.5 10.0 12.5]}
   :quantity :peak-tau1-nm
   :limit {:max 110.0 :basis "estimate: continuous shoulder torque of a ~10 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 30.0}}
  {:id :restock-cart-to-closet
   :kind :transport
   :procedure "robot brings the restock cart 60 m from the loading area to the supply closet"
   :params {:mass-kg 50.0 :distance-m 60.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 120.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [20.0 60.0 100.0 150.0 250.0]}
   :quantity :cycle-time-s
   :limit {:max 75.0 :basis "estimate: one restock leg fits the quiet window before office hours"}
   :boundary {:lo 10.0 :hi 550.0}}]}
